Imports System.Threading

Public Class Form1
    Public CompteurGlobal As Integer = 0
    Private CompteurLocal As Integer = 0

    Dim IsFormLoaded As Boolean = False


    Private WithEvents incrementTimer As New System.Windows.Forms.Timer()
    Private incrementMax As Integer = 0
    Private incrementCount As Integer = 0


    Private Sub Form1_Load(sender As Object, e As EventArgs) Handles MyBase.Load
        IsFormLoaded = True
    End Sub

    Private Sub TextBoxCompteurGlobal_Click(sender As Object, e As EventArgs) Handles TextBoxCompteurGlobal.Click

    End Sub

    Private Sub TextBoxCompteurLocal_Click(sender As Object, e As EventArgs) Handles TextBoxCompteurLocal.Click

    End Sub

    Private Sub ButtonIncrement_Click(sender As Object, e As EventArgs) Handles ButtonIncrement.Click
        Try
            If IsFormLoaded Then
                If incrementTimer.Enabled Then
                    incrementTimer.Stop()
                End If

                incrementMax = 50
                incrementCount = 0
                incrementTimer.Interval = 500
                incrementTimer.Start()
            End If
        Catch ex As Exception
            Console.WriteLine(ex.Message)
        End Try
    End Sub

    Private Sub incrementTimer_Tick(sender As Object, e As EventArgs) Handles incrementTimer.Tick
        Try
            If incrementCount < incrementMax Then
                CompteurGlobal += 1
                CompteurLocal += 1
                TextBoxCompteurGlobal.Text = CompteurGlobal.ToString()
                TextBoxCompteurLocal.Text = CompteurLocal.ToString()
                incrementCount += 1
            Else
                incrementTimer.Stop()
            End If
        Catch ex As Exception
            Console.WriteLine(ex.Message)
            incrementTimer.Stop()
        End Try
    End Sub

    Private Sub Form1_Closing(sender As Object, e As EventArgs) Handles MyBase.Closing
        MessageBox.Show("Form is closing. ")
    End Sub

    Private Sub Form1_Closed(sender As Object, e As EventArgs) Handles MyBase.Closed
        MessageBox.Show("Form is closed. Final CompteurGlobal value: " & CompteurGlobal.ToString() & " and Final CompteurLocal value: " & CompteurLocal.ToString())
    End Sub


End Class